{
	"name": "newspack-lite-site",
	"version": "0.2.0",
	"description": "Lightweight Newspack site configuration",
	"license": "GPL-3.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Automattic/newspack-lite-site.git"
	},
	"bugs": {
		"url": "https://github.com/Automattic/newspack-lite-site/issues"
	},
	"homepage": "https://github.com/Automattic/newspack-lite-site#readme",
	"scripts": {
		"cm": "git-cz",
		"semantic-release": "newspack-scripts release --files=newspack-lite-site.php",
		"clean": "rm -rf dist",
		"build": "npm run clean && newspack-scripts wp-scripts build",
		"start": "npm ci && npm run watch",
		"watch": "npm run clean && newspack-scripts wp-scripts start",
		"test": "echo 'No JS unit tests in this repository.'",
		"test:php": "./vendor/bin/phpunit",
		"lint": "npm run lint:scss && npm run lint:js",
		"lint:js": "newspack-scripts wp-scripts lint-js '**/{src,includes,assets}/**/*.{js,jsx,ts,tsx}'",
		"lint:js:staged": "newspack-scripts wp-scripts lint-js --ext .js,.jsx,.ts,.tsx",
		"fix:js": "newspack-scripts wp-scripts lint-js --fix '**/{src,includes,assets}/**/*.{js,jsx,ts,tsx}'",
		"format:js": "newspack-scripts wp-scripts format '**/{src,includes,assets}/**/*.{js,jsx,ts,tsx}'",
		"lint:php": "./vendor/bin/phpcs",
		"lint:php:staged": "./vendor/bin/phpcs --filter=GitStaged",
		"fix:php": "./vendor/bin/phpcbf",
		"lint:scss": "newspack-scripts wp-scripts lint-style '**/{src,includes,assets}/**/*.scss' --customSyntax postcss-scss",
		"lint:scss:staged": "newspack-scripts wp-scripts lint-style --customSyntax postcss-scss",
		"format:scss": "newspack-scripts wp-scripts lint-style '**/{src,includes,assets}/**/*.scss' --customSyntax postcss-scss --fix",
		"release": "npm run build && npm run semantic-release",
		"release:archive": "rm -rf release && mkdir -p release && rsync -r . ./release/newspack-lite-site --exclude-from='./.distignore' && cd release && zip -r newspack-lite-site.zip newspack-lite-site"
	},
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": "npm run lint:js:staged",
		"*.scss": "npm run lint:scss:staged",
		"*.php": "npm run lint:php:staged"
	},
	"dependencies": {
		"@wordpress/dataviews": "^22.0.0",
		"newspack-components": "~4.11.0",
		"react-router-dom": "^5.3.4"
	},
	"devDependencies": {
		"@types/react-router-dom": "^5.3.3",
		"@wordpress/api-fetch": "^7.57.0",
		"@wordpress/components": "^40.1.0",
		"@wordpress/data": "^10.57.0",
		"@wordpress/date": "^5.57.0",
		"@wordpress/element": "^8.7.0",
		"@wordpress/i18n": "^6.30.0",
		"@wordpress/icons": "^16.0.0",
		"newspack-scripts": "^5.12.0"
	},
	"files": [
		"newspack-lite-site.php",
		"languages",
		"includes",
		"dist",
		"vendor"
	],
	"overrides": {
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"newspack-components": {
			"@wordpress/api-fetch": "^7.55.0",
			"@wordpress/base-styles": "^6.20.0",
			"@wordpress/components": "^40.1.0",
			"@wordpress/compose": "^8.8.0",
			"@wordpress/data": "^10.55.0",
			"@wordpress/dataviews": "^22.0.0",
			"@wordpress/dom-ready": "^4.55.0",
			"@wordpress/element": "^8.7.0",
			"@wordpress/hooks": "^4.55.0",
			"@wordpress/html-entities": "^4.55.0",
			"@wordpress/i18n": "^6.28.0",
			"@wordpress/icons": "^16.0.0",
			"@wordpress/keycodes": "^4.55.0",
			"@wordpress/url": "^4.55.0"
		}
	}
}
