{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "base",
					"color": "#111111",
					"name": "Base"
				},
				{
					"slug": "contrast",
					"color": "#eeeeee",
					"name": "Contrast"
				},
				{
					"slug": "accent",
					"color": "#ffc857",
					"name": "Accent"
				},
				{
					"slug": "link",
					"color": "#2255aa",
					"name": "Link"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "newsreader",
					"fontFamily": "\"Newsreader\", ui-serif, serif",
					"name": "Newsreader",
					"fontFace": [
						{
							"fontFamily": "Newsreader",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"src": [
								"file:./assets/fonts/newsreader.woff2"
							]
						}
					]
				},
				{
					"slug": "cardo",
					"fontFamily": "Cardo",
					"name": "Cardo"
				},
				{
					"slug": "inter",
					"fontFamily": "\"Inter\", system-ui, sans-serif",
					"name": "Inter",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"src": [
								"file:./assets/fonts/inter.woff2"
							]
						}
					]
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|newsreader"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--link)"
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--inter)"
				}
			}
		}
	}
}
